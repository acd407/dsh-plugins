  "license": "MIT",
  "engines": {
    "dsh": "^0.2.2-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acd407/dsh-plugins.git",
    "directory": "packages/subagent-defaults"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
